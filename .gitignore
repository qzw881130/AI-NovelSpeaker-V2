__pycache__/
*.py[cod]

# Local Python/tool caches
.venv/
.ruff_cache/
.pytest_cache/

# macOS
.DS_Store

# Local runtime database
tasks.db
data/*.db
data/*.db-*

# Keep currently tracked novel files, ignore new ones later.
# (tracked files remain tracked even when matched here)
novel/**

# Keep output directory, ignore generated bundles/files
output/*
!output/.gitkeep

# Keep temp directory, ignore generated temp files
temp/*
!temp/.gitkeep

# Keep logs directory, ignore runtime log files
logs/*
!logs/.gitkeep
